# Copy this file to .env and fill in the values. Never commit .env.

# Postgres with the pgvector extension.
# Local Docker (see docs/SETUP.md):
DATABASE_URL=postgresql+psycopg2://hireview:hireview@localhost:5433/hireview
# Supabase: use the connection string from Project Settings -> Database, with the postgresql+psycopg2:// prefix.

# Groq LLM — create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any chat model your key can access. llama-3.3-70b-versatile was the original choice; openai/gpt-oss-120b also works.
GROQ_MODEL=openai/gpt-oss-120b
